{
  "name": "@ancientstudio/ascii-engine-module",
  "version": "1.0.0",
  "description": "Decoupled real-time 3D WebGL ASCII rendering engine with dynamic lighting, shadows, depth-of-field, and glyph bloom.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
