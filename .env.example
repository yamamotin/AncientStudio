# Copy to .env and replace every dev-only secret before any non-local deployment.
# The FastAPI app fails fast when ENVIRONMENT is not local/test/dev/development
# and any secret below still contains "dev-only-" or "change-me".
APP_NAME=AncientStudio API
ENVIRONMENT=local
PORT=8000

# Gateway HMAC: used for X-Signature validation on /api/v1/gateway/*.
GATEWAY_HMAC_SECRET=dev-only-gateway-secret-change-me
SIGNATURE_MAX_AGE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=300

# Workflow API access (header X-API-Key on /api/v1/workflows/*).
WORKFLOW_API_TOKEN=dev-only-workflow-token-change-me

# n8n integration. From the backend container, use service name "n8n".
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_API_TOKEN=dev-only-n8n-token-change-me
N8N_WEBHOOK_TOKEN=dev-only-n8n-webhook-token-change-me
N8N_TIMEOUT_SECONDS=10

# n8n UI (docker-compose). Required: no default credentials in images.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_PUBLIC_URL=http://localhost:5678/
N8N_EVENT_BRIDGE_ENABLED=true

# Phase 2: Distributed Redis Cache & Job Queue (optional locally; falls back to memory)
# REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=ancientstudio
REDIS_FALLBACK_TO_MEMORY=true
WORKER_AUTOSTART=true
WORKER_CONCURRENCY=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=240
RATE_LIMIT_ADMIN_PER_MINUTE=600

# Phase 3: Web Scraping & OpenAI-compatible Structured Inference (OpenAI / vLLM / OpenShift AI)
SCRAPER_MAX_RESPONSE_BYTES=1048576
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_RETRIES=2
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
# AI_PROVIDER_API_KEY=replace-with-real-provider-key

# Phase 5: Interactive Technical RAG Console (hybrid BM25 + dense vector RRF)
RAG_CHUNK_MAX_CHARS=1400
RAG_CHUNK_OVERLAP_LINES=4
RAG_VECTOR_DIMENSIONS=256
RAG_DEFAULT_TOP_K=5
RAG_HYBRID_ALPHA=0.5
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vercel Container Registry (VCR) cleanup automation (scripts/vcr-cleanup.js)
# VERCEL_TOKEN=replace-with-vercel-token
# VERCEL_ORG_ID=replace-with-vercel-team-id
# VERCEL_PROJECT_ID=ancientstudio
VCR_REPOSITORY=dockerfile
VCR_KEEP_COUNT=3

