# Copy to .env and replace every dev-only secret before any non-local deployment.
# The FastAPI app fails fast when ENVIRONMENT is not local/test/dev/development
# and any secret below still contains "dev-only-" or "change-me".
APP_NAME=AncientStudio API
ENVIRONMENT=local
PORT=8000

# Gateway HMAC: used for X-Signature validation on /api/v1/gateway/*.
GATEWAY_HMAC_SECRET=dev-only-gateway-secret-change-me
SIGNATURE_MAX_AGE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=300

# Workflow API access (header X-API-Key on /api/v1/workflows/*).
WORKFLOW_API_TOKEN=dev-only-workflow-token-change-me

# n8n integration. From the backend container, use service name "n8n".
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_API_TOKEN=dev-only-n8n-token-change-me
N8N_WEBHOOK_TOKEN=dev-only-n8n-webhook-token-change-me
N8N_TIMEOUT_SECONDS=10

# n8n UI (docker-compose). Required: no default credentials in images.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_PUBLIC_URL=http://localhost:5678/
